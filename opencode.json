{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "type": "remote",
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "next-devtools": {
      "type": "local",
      "command": ["npx", "-y", "next-devtools-mcp@latest"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"],
      "enabled": true
    },
    "expo": {
      "type": "remote",
      "url": "https://mcp.expo.dev/mcp",
      "enabled": true
    },
    "knip": {
      "type": "local",
      "command": ["npx", "-y", "@knip/mcp"],
      "enabled": true
    }
  },
  "share": "disabled"
}
