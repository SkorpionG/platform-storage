{
  "name": "@platform-storage/react-native",
  "version": "0.0.0",
  "description": "Schema-first, type-safe React Native storage: define your storage once, get validation and TypeScript inference on every read and write.",
  "keywords": [
    "async-storage",
    "asyncStorage",
    "asyncstorage",
    "expo",
    "key-value",
    "react-native",
    "react-native-async-storage",
    "schema",
    "standard-schema",
    "storage",
    "type-safe",
    "typescript",
    "validation",
    "zod"
  ],
  "homepage": "https://github.com/SkorpionG/platform-storage/tree/main/packages/react-native#readme",
  "bugs": {
    "url": "https://github.com/SkorpionG/platform-storage/issues"
  },
  "license": "MIT",
  "author": "SkorpionG",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkorpionG/platform-storage.git",
    "directory": "packages/react-native"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check-package": "pnpm pack --out .cache/package.tgz && publint .cache/package.tgz && attw .cache/package.tgz",
    "clean": "rm -rf dist .cache .turbo node_modules"
  },
  "dependencies": {
    "@platform-storage/core": "workspace:*"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@react-native-async-storage/async-storage": "catalog:",
    "@tooling/oxlint-config": "workspace:*",
    "@tooling/typescript-config": "workspace:*",
    "@tooling/vitest-config": "workspace:*",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "publint": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
