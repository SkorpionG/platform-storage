{
  "cSpell.words": [
    "arethetypeswrong",
    "arktype",
    "attw",
    "changesets",
    "knip",
    "lefthook",
    "oxfmt",
    "oxlint",
    "publint",
    "rolldown",
    "skorpiong",
    "tsbuildinfo",
    "tsdown",
    "turborepo",
    "valibot",
    "vite",
    "vitest",
    "webext",
    "webextension"
  ],
  "files.watcherExclude": {
    ".git/objects/**": true,
    ".git/subtree-cache/**": true,
    "*/.git/objects/**": true,
    "*/.git/subtree-cache/**": true,
    "**/.kilo/worktrees/**": true,
    "**/.kilocode/worktrees/**": true,
    "**/.agent": true,
    "**/.cache": true,
    "**/.turbo": true,
    "**/.output": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/.wxt": true,
    "**/.expo": true
  },
  "search.exclude": {
    "**/.agent": true,
    "**/.cache": true,
    "**/.turbo": true,
    "**/.output": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/.next": true,
    "**/.wxt": true,
    "**/.expo": true
  },
  "specstory.helpUsImprove": false,
  "specstory.autoSave.enabled": true,
  "specstory.cloudSync.enabled": "always",
  "json.schemaDownload.trustedDomains": {
    "https://turborepo.dev/schema.json": true,
    "https://unpkg.com/@changesets/config@3.1.1/schema.json": true,
    "https://opencode.ai/config.json": true,
    "https://models.dev/model-schema.json": true,
    "https://unpkg.com/knip@6/schema-jsonc.json": true,
    "https://unpkg.com/knip@6/schema.json": true
  },
  // The editor decides a file is JSONC from its name, and knows `tsconfig.json` but not the shared bases these packages extend. Both tools read comments in their own configs — `tsc` has always allowed them, and oxlint documents them — so without this the editor reports an error in a file that is perfectly valid.
  "files.associations": {
    "**/tooling/typescript/*.json": "jsonc",
    "**/tooling/oxlint/*.json": "jsonc"
  },
  // Mapped here rather than with a `$schema` inside each file. A relative `$schema` is resolved against the document's own URI, so opening one of these from git history looks for the schema under `git:` and fails; these paths are resolved against the workspace root instead. Reading the installed copy also means the rules validated against are always the ones oxlint enforces, with no version to keep in step.
  "json.schemas": [
    {
      "fileMatch": ["**/.oxlintrc.json", "**/tooling/oxlint/base.json"],
      "url": "./node_modules/oxlint/configuration_schema.json"
    },
    {
      "fileMatch": ["**/.oxfmtrc.json"],
      "url": "./node_modules/oxfmt/configuration_schema.json"
    }
  ],
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  // Every language `pnpm format` touches is named here. A language left out falls to whatever formatter the editor picks by default, which then disagrees with `format:check` and rewrites the file on open.
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[jsonc]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[css]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  // The repository never hard-wraps prose, so the editor does the wrapping.
  "[markdown]": { "editor.defaultFormatter": "oxc.oxc-vscode", "editor.wordWrap": "on" },
  // The repository's pinned version. Without this, an installed TypeScript Nightly extension makes the editor disagree with `tsc`.
  "js/ts.tsdk.path": "packages/core/node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },
  // Both match `.oxfmtrc.json`.
  "editor.rulers": [100],
  "files.eol": "\n"
}
