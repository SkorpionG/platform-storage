{
  "servers": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "type": "http"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": ["-y", "chrome-devtools-mcp@latest", "--no-usage-statistics"],
      "type": "stdio"
    },
    "gh_grep": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "next-devtools": {
      "command": "npx",
      "args": ["-y", "next-devtools-mcp@latest"],
      "type": "stdio"
    },
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"],
      "type": "stdio"
    },
    "expo": {
      "url": "https://mcp.expo.dev/mcp",
      "type": "http"
    },
    "knip": {
      "command": "npx",
      "args": ["-y", "@knip/mcp"],
      "type": "stdio"
    }
  },
  "inputs": []
}
